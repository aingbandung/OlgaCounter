{
  "name": "stopwatch-latihan",
  "version": "1.0.0",
  "private": true,
  "description": "OlgaCounter + penghitung Push-up/Sit-up berbasis kamera, dibungkus Capacitor menjadi APK",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "vendor": "node scripts/prepare-vendor.mjs",
    "android:add": "cap add android && node scripts/patch-android.mjs",
    "android:sync": "node scripts/prepare-vendor.mjs && cap sync android"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@mediapipe/tasks-vision": "0.10.14"
  }
}
